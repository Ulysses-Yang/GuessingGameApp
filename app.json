{
  "expo": {
    "name": "楊承祐的小遊戲",
    "slug": "GuessingGameApp",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/U.png",
    "scheme": "guessinggameapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#00FF00",
      "resizeMode": "contain",
      "image": "./assets/images/U.png"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ulysses.guessinggameapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/U.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6c8ec0f8-15b1-4f98-8112-69bcbdc2301c"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6c8ec0f8-15b1-4f98-8112-69bcbdc2301c"
    }
  }
}
